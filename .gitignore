/models/*/weights*
/models/*/*.bin
/models/*/*.safetensors
/models/*/*.ckpt
/models/*/*.pt
/models/*/*.pth

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
venv/
.venv/
*.egg-info/
build/
